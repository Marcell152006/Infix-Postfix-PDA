gn: center;&quot;&gt;8&lt;/td&gt;&lt;td style=&quot;border: 1.5px solid rgb(142, 169, 219); padding: 8px 16px;&quot;&gt;ε , T&#39; → / F T&#39;&lt;/td&gt;&lt;td style=&quot;border: 1.5px solid rgb(142, 169, 219); padding: 8px 16px;&quot;&gt;Operator pembagian&lt;/td&gt;&lt;/tr&gt;      &lt;tr&gt;&lt;td style=&quot;border: 1.5px solid rgb(142, 169, 219); padding: 8px 14px; text-align: center;&quot;&gt;9&lt;/td&gt;&lt;td style=&quot;border: 1.5px solid rgb(142, 169, 219); padding: 8px 16px;&quot;&gt;ε , T&#39; → ε&lt;/td&gt;&lt;td style=&quot;border: 1.5px solid rgb(142, 169, 219); padding: 8px 16px;&quot;&gt;Akhiri T&#39;&lt;/td&gt;&lt;/tr&gt;      &lt;tr&gt;&lt;td style=&quot;border: 1.5px solid rgb(142, 169, 219); padding: 8px 14px; text-align: center;&quot;&gt;10&lt;/td&gt;&lt;td style=&quot;border: 1.5px solid rgb(142, 169, 219); padding: 8px 16px;&quot;&gt;ε , F → ( E )&lt;/td&gt;&lt;td style=&quot;border: 1.5px solid rgb(142, 169, 219); padding: 8px 16px;&quot;&gt;Ekspresi dalam kurung&lt;/td&gt;&lt;/tr&gt;      &lt;tr&gt;&lt;td style=&quot;border: 1.5px solid rgb(142, 169, 219); padding: 8px 14px; text-align: center;&quot;&gt;11&lt;/td&gt;&lt;td style=&quot;border: 1.5px solid rgb(142, 169, 219); padding: 8px 16px;&quot;&gt;ε , F → 0 | 1 | 2 | ... | 9&lt;/td&gt;&lt;td style=&quot;border: 1.5px solid rgb(142, 169, 219); padding: 8px 16px;&quot;&gt;Operand berupa angka 0 - 9&lt;/td&gt;&lt;/tr&gt;      &lt;tr&gt;&lt;td style=&quot;border: 1.5px solid rgb(142, 169, 219); padding: 8px 14px; text-align: center;&quot;&gt;12&lt;/td&gt;&lt;td style=&quot;border: 1.5px solid rgb(142, 169, 219); padding: 8px 16px;&quot;&gt;X , X → ε&lt;br&gt;(X ∈ { ( ) + - * / 0...9 })&lt;/td&gt;&lt;td style=&quot;border: 1.5px solid rgb(142, 169, 219); padding: 8px 16px;&quot;&gt;Cocokkan terminal: jika simbol stack sama dengan input, pop (hapus) stack top&lt;/td&gt;&lt;/tr&gt;    &lt;/tbody&gt;  &lt;/table&gt;&lt;br&gt;  &lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" 